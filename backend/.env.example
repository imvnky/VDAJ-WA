# ============================
# VDAJ SERVICES — ENVIRONMENT
# ============================

# ---- STAGE: local | demo | production ----
NODE_ENV=local
PORT=5000
APP_NAME=vdajservices
APP_VERSION=1.0.0

# ---- DATABASE ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=vdaj_user
DB_PASSWORD=your_secure_password
DB_NAME=vdaj_whatsapp_db
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20

# ---- REDIS ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_KEY_PREFIX=vdaj:

# ---- JWT ----
JWT_SECRET=replace_with_64char_random_hex_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=vdaj_access_token
JWT_REFRESH_SECRET=replace_with_another_64char_random_hex_string
JWT_REFRESH_EXPIRES_IN=30d

# ---- CORS ----
# Local: http://localhost:3000 | Demo: https://demo.vdajservices.com | Prod: https://vdajservices.com
CORS_ORIGIN=http://localhost:3000

# ---- META / WHATSAPP ----
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_API_VERSION=v19.0
META_GRAPH_API_URL=https://graph.facebook.com

# ---- RATE LIMITING ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---- MESSAGE QUEUE ----
QUEUE_CHUNK_SIZE=50
QUEUE_DELAY_BETWEEN_CHUNKS_MS=1000
QUEUE_MAX_RETRIES=3
QUEUE_BACKOFF_DELAY_MS=5000
QUEUE_DEAD_LETTER_THRESHOLD=3

# ---- LOGGING ----
LOG_LEVEL=debug
LOG_DIR=./logs

# ---- TENANT MODE ----
# multi (India SaaS) | standalone (Angola dedicated)
TENANT_MODE=multi

# ---- NGROK (LOCAL DEV ONLY) ----
NGROK_URL=https://your-tunnel.ngrok.io
